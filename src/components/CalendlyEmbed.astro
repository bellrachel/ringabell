---
// The booking link is always in the HTML. The inline embed is added by
// src/scripts/calendly.ts only when the Contact section is near the viewport.
import { getEntry } from 'astro:content';
import ModeText from './ModeText.astro';

const site = (await getEntry('site', 'site'))!.data;
const copy = (await getEntry('microcopy', 'microcopy'))!.data.calendly;
---

<div class="calendly" data-calendly data-url={site.calendlyUrl} data-title={copy.frameTitle}>
  <div class="frame mono" data-calendly-frame>
    <span><ModeText value={copy.placeholder} /></span>
  </div>
  <a class="mono" href={site.calendlyUrl} target="_blank" rel="noopener"><ModeText value={copy.fallback} /> ↗</a>
</div>

<style>
  .calendly {
    flex: 1 1 420px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .frame {
    width: 100%;
    min-height: 380px;
    border: 1.5px dashed var(--ink);
    border-radius: var(--radius-card);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
    overflow: hidden;
  }
  .frame:global(.is-loaded) {
    padding: 0;
    border-style: solid;
    background: var(--white);
  }
  .frame :global(iframe) {
    display: block;
    width: 100%;
    height: 680px;
    border: 0;
  }
</style>
