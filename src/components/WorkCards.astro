---
import { getCollection, getEntry } from 'astro:content';
import ModeText from './ModeText.astro';

const section = (await getEntry('sections', 'work'))!.data;
const cards = (await getCollection('cards')).sort((a, b) => a.data.order - b.data.order);
const achievements = await getCollection('achievements');

/** Resolves `achievement-id/fact-id` to the fact, so numbers are never retyped. */
function fact(ref: string) {
  const [achievementId, factId] = ref.split('/');
  const found = achievements
    .find((a) => a.id === achievementId)
    ?.data.facts.find((f) => f.id === factId);
  if (!found) throw new Error(`Unknown fact reference: ${ref}`);
  return found;
}
---

<section id="work" class="section" aria-labelledby="work-label">
  <div class="wrap">
    <h2 id="work-label" class="label mono"><ModeText value={section.label} /></h2>
    <div class="grid3">
      {
        cards.map((card) => (
          <article class="card">
            <h3 class="display"><ModeText value={card.data.title} /></h3>
            <p><ModeText value={card.data.text} /></p>
            <ul class="chips">
              {card.data.chips.map(fact).map((f) => (
                <li class="chip" title={f.detail}>
                  {f.value}
                  {f.label && ` ${f.label}`}
                  <span class="visually-hidden">: {f.detail}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Card, grid and chip styles are shared with the lab (src/styles/base.css). */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }
</style>
