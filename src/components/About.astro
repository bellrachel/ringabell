---
import { getEntry } from 'astro:content';
import ModeText from './ModeText.astro';
import { format } from '../lib/text';

const section = (await getEntry('sections', 'about'))!.data;
const voices = section.paragraphs ? (['pro', 'fire'] as const) : [];
---

{
  section.enabled && (
    <section id="about" class="section" aria-labelledby="about-heading">
      <div class="wrap about">
        <div>
          <p class="label mono">
            <ModeText value={section.label} />
          </p>
          <h2 id="about-heading" class="display">
            <ModeText value={section.heading} />
          </h2>
        </div>
        <div>
          {voices.map((mode) => (
            <div class="text" data-show={mode} data-nosnippet={mode === 'fire' ? '' : undefined}>
              {section.paragraphs![mode].map((paragraph, i) => (
                <p class:list={[{ 'lead display': i === 0 }]} set:html={format(paragraph)} />
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 48px;
  }
  h2 {
    margin: 0;
    font-size: 56px;
    line-height: 1;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 17px;
    line-height: 1.6;
  }
  .text p:last-child {
    margin-bottom: 0;
  }
  .text .lead {
    font-size: 26px;
    line-height: 1.3;
    margin-bottom: 24px;
  }
  @media (max-width: 999px) {
    .about {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    h2 {
      font-size: 40px;
    }
    .text .lead {
      font-size: 22px;
    }
  }
</style>
