---
// A simple centered message, used by the 404 and thanks pages.
import ModeText from './ModeText.astro';
import type { Variant } from '../lib/text';

interface Props {
  heading: Variant;
  body?: Variant;
  cta: Variant;
}
const { heading, body, cta } = Astro.props;
---

<main class="notice wrap">
  <h1 class="display"><ModeText value={heading} /></h1>
  {body && <p><ModeText value={body} /></p>}
  <a class="cta" href="/"><ModeText value={cta} /></a>
</main>

<style>
  .notice {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-top: 80px;
    padding-bottom: 120px;
  }
  h1 {
    margin: 0;
    font-size: clamp(40px, 8vw, 72px);
    line-height: 1;
  }
  p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
  }
</style>
