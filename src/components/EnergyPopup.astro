---
// The energy.exe pop-up: a non-modal dialog shown once per session at 75%
// scroll. Behavior lives in src/scripts/energy.ts.
import { getEntry } from 'astro:content';
import ModeText from './ModeText.astro';

const copy = (await getEntry('microcopy', 'microcopy'))!.data.popup;
---

<div class="energy" role="dialog" aria-labelledby="energy-title" aria-describedby="energy-body" data-energy hidden>
  <div class="energy__bar">
    <span id="energy-title">{copy.title}</span>
    <button type="button" data-energy-close aria-label={copy.close}>✕</button>
  </div>
  <div class="energy__body">
    <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M16 3l14 26H2z" fill="#f9db6d" stroke="#191923" stroke-width="2"></path>
      <path d="M16 12v8M16 23v2" stroke="#191923" stroke-width="3"></path>
    </svg>
    <p id="energy-body"><ModeText value={copy.body} /></p>
  </div>
  <div class="energy__actions">
    <button type="button" data-set-mode="pro" data-source="popup" data-energy-close>
      <ModeText value={copy.stay} />
    </button>
    <button type="button" class="primary" data-set-mode="fire" data-source="popup" data-energy-close>
      <ModeText value={copy.switch} />
    </button>
  </div>
</div>

<style>
  .energy {
    position: fixed;
    right: 24px;
    bottom: 24px;
    width: 320px;
    z-index: 10;
    background: var(--popup-bg);
    border: var(--border-cta);
    box-shadow: var(--shadow-hard);
    font: 500 13px var(--font-mono);
  }
  .energy[hidden] {
    display: none;
  }
  .energy__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 4px 4px 4px 10px;
    background: var(--ink);
    color: #fbfef9;
  }
  .energy__bar button {
    cursor: pointer;
    width: 40px;
    height: 32px;
    border: 0;
    background: transparent;
    color: #fbfef9;
    font: 500 16px var(--font-mono);
  }
  .energy__bar button:focus-visible {
    outline-color: #fbfef9;
    outline-offset: -3px;
  }
  .energy__body {
    padding: 16px;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .energy__body svg {
    flex-shrink: 0;
  }
  .energy__body p {
    margin: 0;
    line-height: 1.5;
  }
  .energy__actions {
    display: flex;
    gap: 8px;
    padding: 0 16px 16px;
    justify-content: flex-end;
  }
  .energy__actions button {
    cursor: pointer;
    min-height: 40px;
    padding: 0 14px;
    border: var(--border-cta);
    font: 500 13px var(--font-mono);
    background: var(--popup-btn);
    color: var(--ink);
  }
  .energy__actions .primary {
    background: var(--brand);
    color: #fbfef9;
  }
  @media (max-width: 999px) {
    .energy {
      left: 16px;
      right: 16px;
      bottom: 16px;
      width: auto;
    }
  }
</style>
